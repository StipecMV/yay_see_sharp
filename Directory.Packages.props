<Project>
  <ItemGroup>
    <!--
      ADR: Avalonia.ReactiveUI stays on 11.3.9 against a 12.x core (last re-verified against the
      live NuGet v3-flatcontainer index — `avalonia.reactiveui/index.json` lists no 12.x version,
      11.3.9 remains the newest). This is a deliberate residual-risk decision, not an oversight:

        - It is a thin AppBuilder.UseReactiveUI() scheduler-registration shim (registers
          RxApp.MainThreadScheduler = AvaloniaScheduler.Instance) with no dependency on Avalonia's
          internal rendering/control APIs, so it is expected to keep working across the 11 -> 12
          boundary.
        - Regression coverage: tests/yay_see_sharp.e2e.Tests boots the real Avalonia 12.x app with
          this exact package graph under Avalonia.Headless and exercises ReactiveCommand execution
          end to end (navigation, search, theme/language switching, a real simulated click) — if
          the ReactiveUI scheduler registration broke against the 12.x core, those tests would fail,
          not just "the app looks fine in Debug".
        - Re-check periodically: if a 12.x Avalonia.ReactiveUI release appears upstream, migrate to
          it; do not guess at an unpublished/unverified version number to "match" the core packages.

      Avalonia.Diagnostics has the same 12.x gap but, unlike ReactiveUI, has no safe fallback story
      (it binds Avalonia's internal APIs directly), so it has been dropped rather than left
      mismatched (see the app csproj for the removal note) instead of pinned like ReactiveUI is.
    -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <!--
      Avalonia.Headless has a 12.x release matching the core packages above. There is no official
      Avalonia.Headless.TUnit adapter (only .XUnit/.NUnit exist upstream; the one TUnit package on
      NuGet is an unofficial third-party 0.1.x release, not something to depend on for test
      infrastructure). Avalonia.Headless's own public HeadlessUnitTestSession type — the same
      primitive the official XUnit/NUnit adapters are built on — is used directly instead; see
      tests/yay_see_sharp.e2e.Tests/AvaloniaUiTest.cs.
    -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />

    <PackageVersion Include="log4net" Version="3.3.2" />
    <PackageVersion Include="ReactiveUI.Fody" Version="19.5.41" />
    <PackageVersion Include="Splat" Version="15.1.1" />
    <PackageVersion Include="Splat.Log4Net" Version="14.1.45" />

    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="TUnit" Version="1.63.0" />
  </ItemGroup>
</Project>
