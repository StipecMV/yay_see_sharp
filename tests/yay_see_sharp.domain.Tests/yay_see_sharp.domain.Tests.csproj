<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <IntermediateOutputPath>..\..\output\obj\yay_see_sharp.domain.Tests\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Pure domain logic tests: no Avalonia, no platform I/O, no Moq — the domain project has no
       external dependencies of its own to mock. -->
  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\yay_see_sharp.domain\yay_see_sharp.domain.csproj" />
  </ItemGroup>

</Project>
