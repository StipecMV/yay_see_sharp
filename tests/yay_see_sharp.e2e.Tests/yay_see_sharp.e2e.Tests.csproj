<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <IntermediateOutputPath>..\..\output\obj\yay_see_sharp.e2e.Tests\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <!--
    Avalonia Headless end-to-end tests: real compiled Views + real ViewModels + the real Avalonia
    binding/styling pipeline, run against the headless rendering platform (no display required).
    Backends are Demo or mocked IPackageBackend — never the real yay binary; see the
    yay_see_sharp.integration.Tests project for that.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.ReactiveUI" />
    <PackageReference Include="Moq" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\yay_see_sharp.application\yay_see_sharp.application.csproj" />
    <ProjectReference Include="..\..\source\yay_see_sharp.domain\yay_see_sharp.domain.csproj" />
    <ProjectReference Include="..\..\source\yay_see_sharp.infrastructure\yay_see_sharp.infrastructure.csproj" />
  </ItemGroup>

</Project>
