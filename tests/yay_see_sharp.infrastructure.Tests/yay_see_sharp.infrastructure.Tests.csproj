<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <OutputPath>..\..\output\bin\</OutputPath>
    <IntermediateOutputPath>..\..\output\obj\yay_see_sharp.infrastructure.Tests\</IntermediateOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\yay_see_sharp.domain\yay_see_sharp.domain.csproj" />
    <ProjectReference Include="..\..\source\yay_see_sharp.infrastructure\yay_see_sharp.infrastructure.csproj" />
  </ItemGroup>

</Project>
