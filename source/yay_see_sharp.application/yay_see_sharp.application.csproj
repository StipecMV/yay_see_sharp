<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--Avalonia doesen't support TrimMode=link currently,but we are working on that https://github.com/AvaloniaUI/Avalonia/issues/6892 -->
    <TrimMode>copyused</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <IntermediateOutputPath>..\..\output\obj\yay_see_sharp.application\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
    <WarningLevel>5</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>5</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Folder Include="Interfaces\" />
    <Folder Include="Models\Linux\" />
    <Folder Include="Models\Simulator\" />
  </ItemGroup>
  <ItemGroup>
    <!--This helps with theme dll-s trimming.
    If you will publish your application in self-contained mode with p:PublishTrimmed=true and it will use Fluent theme Default theme will be trimmed from the output and vice versa.
    https://github.com/AvaloniaUI/Avalonia/issues/5593 -->
    <TrimmableAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmableAssembly Include="Avalonia.Themes.Default" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!--
      Avalonia.Diagnostics (the F12 dev-tools overlay) has no release compatible with Avalonia 12
      yet; its latest build (11.3.18) is compiled against Avalonia 11's internal APIs and isn't
      safe to mix with the 12.x core used here. Dropped until an Avalonia 12-compatible release
      exists rather than shipping a version-mismatched dev tool.
    -->
    <PackageReference Include="Avalonia.ReactiveUI" />
    <PackageReference Include="log4net" />
    <PackageReference Include="ReactiveUI.Fody" />
    <PackageReference Include="Splat" />
    <PackageReference Include="Splat.Log4Net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\yay_see_sharp.domain\yay_see_sharp.domain.csproj" />
    <ProjectReference Include="..\yay_see_sharp.infrastructure\yay_see_sharp.infrastructure.csproj" />
  </ItemGroup>
</Project>
