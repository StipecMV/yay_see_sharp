<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:yay_see_sharp.application.ViewModels"
             xmlns:icons="using:yay_see_sharp.application.Views.Icons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="260"
             x:Class="yay_see_sharp.application.Views.AuthPromptView"
             x:DataType="vm:AuthPromptViewModel">

    <Border Width="360" Background="{DynamicResource Brush.Surface}" CornerRadius="14" Padding="22">
        <StackPanel Spacing="14">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource Brush.AccentTint}">
                    <icons:LockIcon Width="17" Height="17" Stroke="{DynamicResource Brush.Accent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding TitleLabel}" FontSize="32" FontWeight="Medium"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{Binding BodyLabel}" FontSize="25" LineHeight="19"
                       Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>

            <StackPanel>
                <TextBlock Text="{Binding PasswordLabel}" FontSize="23" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,5"/>
                <!-- Enter confirms, same as clicking Authenticate — respects the command's own
                     CanExecute (empty password), so it's a no-op rather than a silent submit. -->
                <TextBox Text="{Binding Password}" PasswordChar="•">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AuthenticateCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                <Button Grid.Column="1" Classes="neutral" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="{Binding AuthenticateLabel}" Command="{Binding AuthenticateCommand}"/>
            </Grid>

        </StackPanel>
    </Border>

</UserControl>
