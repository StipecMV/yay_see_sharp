<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:yay_see_sharp.application.ViewModels"
             xmlns:conv="using:yay_see_sharp.application.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="yay_see_sharp.application.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="{DynamicResource Brush.Background}">

    <DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="40,32,40,28" Spacing="28">

            <Border IsVisible="{Binding HasNotification}"
                    Background="{DynamicResource Brush.AccentTint}"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2"
                    CornerRadius="12" Padding="24,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="✓" FontSize="34" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,20,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding NotificationMessage}" FontSize="25"
                               Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="subtle" Content="×" Command="{Binding DismissNotificationCommand}"/>
                </Grid>
            </Border>

            <Border IsVisible="{Binding DisplayErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="Transparent" BorderBrush="{DynamicResource Brush.Destructive}" BorderThickness="2"
                    CornerRadius="12" Padding="24,20">
                <TextBlock Text="{Binding DisplayErrorMessage}" FontSize="25" Foreground="{DynamicResource Brush.Destructive}" TextWrapping="Wrap"/>
            </Border>

            <StackPanel>
                <TextBlock Text="{Binding WelcomeLabel}" FontSize="38" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock Text="{Binding LastSyncedLabel}" FontSize="25" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- BUGFIX-2026-08: no fixed card height — with the doubled UI font the fixed 104px
                 clipped longer labels ("Updates available"); cards now grow with their content. -->
            <Grid ColumnDefinitions="*,*,*">
                <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" CornerRadius="12" Padding="24,20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Statistics.InstalledCount}" FontSize="36" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}"/>
                        <TextBlock Text="{Binding InstalledLabel}" FontSize="22" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource Brush.Sidebar}" CornerRadius="12" Padding="24,20" Margin="10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Statistics.AurCount}" FontSize="36" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}"/>
                        <TextBlock Text="{Binding AurLabel}" FontSize="22" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource Brush.Sidebar}" CornerRadius="12" Padding="24,20" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Statistics.UpdatesAvailable}" FontSize="36" FontWeight="Medium" Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{Binding UpdatesAvailableLabel}" FontSize="22" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Spacing="8" IsVisible="{Binding UpdateOperation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding UpdateOperation.StageLabel}" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}"/>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateOperation.Percent}" Height="8"
                             Background="{DynamicResource Brush.Divider}" Foreground="{DynamicResource Brush.Accent}"/>
                <Button Classes="neutral" Content="{Binding UpdateOperation.CancelLabel}" Command="{Binding UpdateOperation.CancelCommand}" HorizontalAlignment="Left"/>
            </StackPanel>

        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="40,12,40,16" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding UpdatesLabel}" FontSize="26" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{Binding UpdateAllLabel}" Command="{Binding UpdateAllCommand}" IsVisible="{Binding !HasNoUpdates}"/>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Margin="40,0" Text="{Binding NoUpdatesLabel}" IsVisible="{Binding HasNoUpdates}"
                   FontSize="25" Foreground="{DynamicResource Brush.TextFaint}"/>

        <ScrollViewer Margin="40,0,40,32">
            <ItemsControl ItemsSource="{Binding UpdateItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UpdateItemViewModel">
                        <!-- UI-05: the row navigates to the package's Installed detail; Update stays
                             an independent shortcut button (nested-button click routing keeps the
                             two from triggering each other — see SearchView's identical pattern). -->
                        <Button Classes="row" Padding="20,18"
                                Command="{Binding SelectCommand}" CommandParameter="{Binding Info.Name}">
                            <Grid ColumnDefinitions="52,*,Auto,Auto">
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                        Background="{DynamicResource Brush.AccentTint}" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Info.Name, Converter={x:Static conv:InitialsConverter.Instance}}"
                                               FontFamily="{DynamicResource Font.Monospace}" FontWeight="SemiBold" FontSize="26"
                                               Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Info.Name}" FontSize="26" Foreground="{DynamicResource Brush.Text}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Info.CurrentVersion}" FontSize="22" FontFamily="{DynamicResource Font.Monospace}" Foreground="{DynamicResource Brush.TextFaint}"/>
                                        <TextBlock Text="→" FontSize="22" Foreground="{DynamicResource Brush.TextFaint}"/>
                                        <TextBlock Text="{Binding Info.AvailableVersion}" FontSize="22" FontFamily="{DynamicResource Font.Monospace}" Foreground="{DynamicResource Brush.TextFaint}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Theme="{StaticResource TagNeutral}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Info.Source, Converter={x:Static conv:PackageSourceTagConverter.Instance}}"
                                               FontSize="24" Foreground="{DynamicResource Brush.TagNeutralFg}"/>
                                </Border>
                                <Button Grid.Column="3" Classes="neutral" Content="{Binding UpdateLabel}"
                                        Command="{Binding UpdateCommand}" CommandParameter="{Binding Info.Name}"
                                        Padding="20,10" FontSize="25" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
