<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:yay_see_sharp.application.ViewModels"
             xmlns:models="using:yay_see_sharp.domain.Models"
             xmlns:conv="using:yay_see_sharp.application.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="yay_see_sharp.application.Views.InstalledPackagesView"
             x:DataType="vm:InstalledPackagesViewModel"
             Background="{DynamicResource Brush.Background}">

    <Panel>
        <DockPanel>

            <Grid DockPanel.Dock="Top" Margin="20,16,20,10" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding EmptyLabel}" IsVisible="{Binding HasNoPackages}"
                           FontSize="12.5" Foreground="{DynamicResource Brush.TextFaint}"/>
                <Button Grid.Column="1" Classes="neutral" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}"/>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Margin="20,0" Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource Brush.Destructive}" FontSize="12" TextWrapping="Wrap"/>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,3*">
                <ScrollViewer Grid.Column="0" Margin="20,0,10,16">
                    <ListBox Classes="plain" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:PackageSummary" x:CompileBindings="False">
                                <Border Background="{DynamicResource Brush.RowFill}" CornerRadius="8" Padding="10,9">
                                    <Grid ColumnDefinitions="*,64,52,44">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="11" FontFamily="{DynamicResource Font.Monospace}"
                                                   Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding InstalledSizeBytes, Converter={x:Static conv:ByteSizeConverter.Instance}}"
                                                   FontSize="11" Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="3" Theme="{StaticResource TagNeutral}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source, Converter={x:Static conv:PackageSourceTagConverter.Instance}}"
                                                       FontSize="9.5" Foreground="{DynamicResource Brush.TagNeutralFg}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <ContentControl Grid.Column="1" Margin="0,0,20,16" Content="{Binding SelectedDetails}"/>
            </Grid>

        </DockPanel>

        <!-- Build progress modal: minimizing hides this overlay without cancelling the underlying operation. -->
        <Border IsVisible="{Binding BuildJob, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource Brush.ScrimBackdrop}">
            <Border IsVisible="{Binding !BuildJob.IsMinimized, FallbackValue=False}"
                    Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding BuildJob.TitleLabel}" FontSize="15" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <Button Grid.Column="1" Classes="subtle" Content="×" Command="{Binding BuildJob.MinimizeCommand}"/>
                    </Grid>
                    <Border Background="{DynamicResource Brush.Background}" CornerRadius="8" Padding="10" Height="120">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding BuildJob.LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontFamily="{DynamicResource Font.Monospace}" FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BuildJob.Operation.Percent}" Height="4"
                                 Background="{DynamicResource Brush.Divider}" Foreground="{DynamicResource Brush.Accent}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding BuildJob.Operation.StageLabel}" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="neutral" Content="{Binding BuildJob.RunInBackgroundLabel}"
                                Command="{Binding BuildJob.MinimizeCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Minimized: small reopenable chip pinned to the corner instead of a full modal. -->
        <Border IsVisible="{Binding BuildJob.IsMinimized, FallbackValue=False}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20"
                Background="{DynamicResource Brush.Surface}" CornerRadius="8" Padding="12,8" Cursor="Hand">
            <Border.IsHitTestVisible>True</Border.IsHitTestVisible>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding BuildJob.TitleLabel}" FontSize="12" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                <Button Classes="neutral" Content="⤢" Padding="6,3" Command="{Binding BuildJob.RestoreCommand}"/>
            </StackPanel>
        </Border>

    </Panel>

</UserControl>
