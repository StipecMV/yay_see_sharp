<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:yay_see_sharp.application.ViewModels"
             xmlns:models="using:yay_see_sharp.domain.Models"
             xmlns:icons="using:yay_see_sharp.application.Views.Icons"
             xmlns:conv="using:yay_see_sharp.application.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="yay_see_sharp.application.Views.SearchView"
             x:DataType="vm:SearchViewModel"
             Background="{DynamicResource Brush.Background}">

    <DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="40,32,40,20" Spacing="20">

            <!-- UI-07: filter toggle buttons above the search bar; live search below, no button. -->
            <ListBox Theme="{StaticResource SegmentedListBox}"
                     ItemsSource="{Binding SourceOptions}"
                     SelectedItem="{Binding SelectedSourceOption}"
                     HorizontalAlignment="Left">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="1" CornerRadius="12" Padding="24,16">
                <Grid ColumnDefinitions="Auto,*">
                    <icons:SearchIcon Grid.Column="0" Width="30" Height="30" Margin="0,0,16,0"
                                      Stroke="{DynamicResource Brush.TextFaint}"/>
                    <TextBox Grid.Column="1" Text="{Binding Query}" PlaceholderText="{Binding PlaceholderLabel}"
                             Background="Transparent" BorderThickness="0" Padding="0"/>
                </Grid>
            </Border>

            <!-- BUGFIX-2026-08: a visible loading indicator while a search/filter change is in
                 flight (yay searches can take seconds on a cold cache) — the previous behaviour
                 of keeping the old rows on screen with no feedback read as a broken UI. -->
            <ProgressBar IsIndeterminate="True" Height="6" IsVisible="{Binding IsBusy}"
                         Background="{DynamicResource Brush.Divider}" Foreground="{DynamicResource Brush.Accent}"
                         CornerRadius="3"/>

            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource Brush.Destructive}" FontSize="24" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="40,8" Text="{Binding NoResultsLabel}" IsVisible="{Binding HasNoResults}"
                   FontSize="25" Foreground="{DynamicResource Brush.TextFaint}"/>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,3*">
            <ScrollViewer Grid.Column="0" Margin="40,0,20,32">
                <!-- BUGFIX-2026-08: a real ListBox (was: ItemsControl of Buttons) so the selected
                     row stays visibly selected and the right-hand detail pane always corresponds
                     to it; selection is re-applied by name after every live-search reload. -->
                <ListBox Classes="plain" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedPackage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PackageSummary" x:CompileBindings="False">
                            <Border Classes="row-card" Background="{DynamicResource Brush.RowFill}"
                                    CornerRadius="12" Padding="20,18">
                                <Grid ColumnDefinitions="64,*,Auto">
                                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14" VerticalAlignment="Top"
                                            Margin="0,0,20,0" Background="{DynamicResource Brush.AccentTint}">
                                        <TextBlock Text="{Binding Name, Converter={x:Static conv:InitialsConverter.Instance}}"
                                                   FontFamily="{DynamicResource Font.Monospace}" FontWeight="SemiBold" FontSize="30"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Classes="name" Text="{Binding Name}" FontSize="27" Foreground="{DynamicResource Brush.Text}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Theme="{StaticResource TagNeutral}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Source, Converter={x:Static conv:PackageSourceTagConverter.Instance}}"
                                                           FontSize="24" Foreground="{DynamicResource Brush.TagNeutralFg}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="23" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="21" Foreground="{DynamicResource Brush.TextFaint}" FontFamily="{DynamicResource Font.Monospace}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Votes, Converter={x:Static conv:VotesConverter.Instance}}"/>
                                            <Run Text="v"/><Run Text="{Binding Version}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Theme="{StaticResource TagAccent}" VerticalAlignment="Center"
                                            IsVisible="{Binding State, Converter={x:Static conv:PackageStateIsInstalledConverter.Instance}}">
                                        <TextBlock Text="{Binding $parent[UserControl].DataContext.InstalledLabel}"
                                                   FontSize="24" Foreground="{DynamicResource Brush.TagAccentFg}"/>
                                    </Border>
                                    <Button Grid.Column="2" VerticalAlignment="Center" FontSize="25" Padding="20,10"
                                            Content="{Binding $parent[UserControl].DataContext.InstallLabel}"
                                            IsVisible="{Binding State, Converter={x:Static conv:PackageStateIsInstalledConverter.Instance}, ConverterParameter=invert}"
                                            Command="{Binding $parent[UserControl].DataContext.InstallCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <ContentControl Grid.Column="1" Margin="0,0,40,32" Content="{Binding SelectedDetails}"/>
        </Grid>

    </DockPanel>

</UserControl>
