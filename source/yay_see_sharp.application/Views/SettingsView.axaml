<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:yay_see_sharp.application.ViewModels"
             xmlns:icons="using:yay_see_sharp.application.Views.Icons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="yay_see_sharp.application.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource Brush.Background}">

    <Panel>
        <ScrollViewer>
            <StackPanel Margin="40,32" Spacing="40" MaxWidth="860">

                <StackPanel>
                    <TextBlock Text="{Binding AppearanceLabel}" FontSize="26" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,16"/>
                    <ListBox Theme="{StaticResource SegmentedListBox}" HorizontalAlignment="Left"
                             ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding Theme}" SelectedValueBinding="{Binding Value}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Binding LanguageLabel}" FontSize="26" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,16"/>
                    <ComboBox Width="440" HorizontalAlignment="Left"
                              ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding Language}" SelectedValueBinding="{Binding Value}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding LanguageHintLabel}" FontSize="22" Foreground="{DynamicResource Brush.TextFaint}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Binding EngineLabel}" FontSize="26" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="{Binding EngineHintLabel}" FontSize="23" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,4,0,20"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <!-- UI-18: only "yay" is ever selectable here, so any press on this picker
                             is effectively clicking it — in Demo/Simulated mode that's informational
                             only (see SettingsViewModel.NotifyIfSimulated). -->
                        <ListBox Theme="{StaticResource SegmentedListBox}"
                                 ItemsSource="{Binding EngineOptions}" SelectedValue="{Binding Engine}" SelectedValueBinding="{Binding Value}"
                                 PointerPressed="OnEngineOptionsPressed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Classes="neutral" Command="{Binding DetectEngineCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <icons:DetectIcon Width="24" Height="24" Stroke="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="{Binding DetectLabel}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!--
                  FINDING-09: the AUR-helper build-directory browser is intentionally not exposed
                  here — see docs/product-requirements.md and README.md for the future-feature
                  note. SettingsViewModel.BuildDirectory (the persisted model field) is kept so
                  reintroducing this UI later is a pure addition, not a data-model change.
                -->

                <StackPanel Spacing="28">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding AutoUpdateLabel}" FontSize="26" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{Binding AutoUpdateHintLabel}" FontSize="23" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpdateCheckEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AutoUpdateCheckEnabled}" Margin="0,-12,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding UpdateScheduleTimeLabel}" FontSize="24" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                        <TimePicker Grid.Column="1" SelectedTime="{Binding UpdateScheduleTimeOfDay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding NotificationsLabel}" FontSize="26" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{Binding NotificationsHintLabel}" FontSize="23" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding MinimizeToTrayLabel}" FontSize="26" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding RemoveOrphansLabel}" FontSize="26" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RemoveOrphansByDefault}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Panel>

</UserControl>
