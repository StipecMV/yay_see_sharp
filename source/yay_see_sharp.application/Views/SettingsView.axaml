<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:yay_see_sharp.application.ViewModels"
             xmlns:icons="using:yay_see_sharp.application.Views.Icons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="yay_see_sharp.application.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource Brush.Background}">

    <Panel>
        <ScrollViewer>
            <StackPanel Margin="24,20" Spacing="20" MaxWidth="480">

                <StackPanel>
                    <TextBlock Text="{Binding AppearanceLabel}" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10"/>
                    <ListBox Theme="{StaticResource SegmentedListBox}" HorizontalAlignment="Left"
                             ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding Theme}" SelectedValueBinding="{Binding Value}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Binding LanguageLabel}" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10"/>
                    <ComboBox Width="220" HorizontalAlignment="Left"
                              ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding Language}" SelectedValueBinding="{Binding Value}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding LanguageHintLabel}" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Binding EngineLabel}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="{Binding EngineHintLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,2,0,10"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ListBox Theme="{StaticResource SegmentedListBox}"
                                 ItemsSource="{Binding EngineOptions}" SelectedValue="{Binding Engine}" SelectedValueBinding="{Binding Value}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Classes="neutral" Command="{Binding DetectEngineCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:DetectIcon Width="12" Height="12" Stroke="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="{Binding DetectLabel}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Binding AurHelperLabel}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="{Binding BuildDirectoryLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,5"/>
                    <Button Command="{Binding BrowseCommand}" HorizontalContentAlignment="Stretch" Padding="10,7">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <icons:FolderIcon Grid.Column="0" Width="13" Height="13" Margin="0,0,8,0" Stroke="{DynamicResource Brush.TextFaint}"/>
                            <TextBlock Grid.Column="1" Text="{Binding BuildDirectory}" FontFamily="{DynamicResource Font.Monospace}"
                                       FontSize="12.5" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding BrowseLabel}" FontSize="11" Foreground="{DynamicResource Brush.Accent}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding AutoUpdateLabel}" FontSize="13" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{Binding AutoUpdateHintLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpdateCheckEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AutoUpdateCheckEnabled}" Margin="0,-6,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding UpdateScheduleTimeLabel}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                        <TimePicker Grid.Column="1" SelectedTime="{Binding UpdateScheduleTimeOfDay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding NotificationsLabel}" FontSize="13" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{Binding NotificationsHintLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding MinimizeToTrayLabel}" FontSize="13" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding RemoveOrphansLabel}" FontSize="13" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RemoveOrphansByDefault}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <TextBlock Text="{Binding SavedLabel}" IsVisible="{Binding IsSaved}" FontSize="11.5" Foreground="{DynamicResource Brush.Accent}"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Folder browser modal -->
        <Border IsVisible="{Binding FolderBrowser, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource Brush.ScrimBackdrop}">
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}" CornerRadius="14" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding FolderBrowser.TitleLabel}" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}"/>

                    <ItemsControl ItemsSource="{Binding FolderBrowser.Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BreadcrumbSegmentViewModel" x:CompileBindings="False">
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,5,0">
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                               Cursor="Hand" PointerPressed="OnBreadcrumbPressed" Tag="{Binding Path}"/>
                                    <TextBlock Text="/" FontSize="12" Foreground="{DynamicResource Brush.TextFaint}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <ScrollViewer MaxHeight="220">
                            <ItemsControl ItemsSource="{Binding FolderBrowser.Children}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FolderEntryViewModel" x:CompileBindings="False">
                                        <Border Padding="10,8" Background="Transparent" Cursor="Hand"
                                                Classes.selected="{Binding IsSelected}"
                                                PointerPressed="OnFolderEntryPressed" DoubleTapped="OnFolderEntryDoubleTapped" Tag="{Binding}">
                                            <Border.Styles>
                                                <Style Selector="Border.selected">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentTint}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <icons:FolderIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                                                                   Stroke="{DynamicResource Brush.TextFaint}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Brush.Text}"/>
                                                <TextBlock Grid.Column="2" Text="✓" FontSize="12" Foreground="{DynamicResource Brush.Accent}"
                                                           IsVisible="{Binding IsSelected}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Divider}"
                            BorderThickness="1" CornerRadius="8" Padding="10,7">
                        <TextBlock Text="{Binding FolderBrowser.DisplayPath}" FontFamily="{DynamicResource Font.Monospace}"
                                   FontSize="12.5" Foreground="{DynamicResource Brush.Text}"/>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1" Classes="neutral" Content="{Binding FolderBrowser.CancelLabel}"
                                Command="{Binding FolderBrowser.CancelCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="{Binding FolderBrowser.SelectLabel}" Command="{Binding FolderBrowser.SelectFolderCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>

</UserControl>
