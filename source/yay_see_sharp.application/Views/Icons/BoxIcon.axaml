<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="yay_see_sharp.application.Views.Icons.BoxIcon"
             x:Name="Root">
  <Viewbox Stretch="Uniform">
    <Canvas Width="14" Height="14">
      <Rectangle Canvas.Left="2" Canvas.Top="5.5" Width="10" Height="7" RadiusX="1" RadiusY="1"
                 StrokeThickness="1.4" Stroke="{Binding #Root.Stroke}"/>
      <Polyline Points="2,5.5 7,2.5 12,5.5" StrokeLineCap="Round" StrokeJoin="Round"
                StrokeThickness="1.4" Stroke="{Binding #Root.Stroke}"/>
    </Canvas>
  </Viewbox>
</UserControl>
