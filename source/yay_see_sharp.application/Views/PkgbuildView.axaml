<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:yay_see_sharp.application.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="420"
             x:Class="yay_see_sharp.application.Views.PkgbuildView"
             x:DataType="vm:PkgbuildViewModel">

    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="20" Padding="32"
            Width="960" MaxHeight="880" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto" MinHeight="360">

            <!-- UI-12: no small × close affordance up here — the large Close button below is the
                 only close control, easier to hit and unambiguous. -->
            <TextBlock Grid.Row="0" Text="{Binding TitleLabel}" FontSize="30" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,24" TextTrimming="CharacterEllipsis"/>

            <Border Grid.Row="1" Background="{DynamicResource Brush.Background}" CornerRadius="12" Padding="20" MinHeight="320">
                <Grid>
                    <TextBlock Text="…" FontSize="26" Foreground="{DynamicResource Brush.TextFaint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsLoading}"/>
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="25" Foreground="{DynamicResource Brush.Destructive}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <ScrollViewer IsVisible="{Binding Content, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <SelectableTextBlock Text="{Binding Content}" FontFamily="{DynamicResource Font.Monospace}"
                                             FontSize="23" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Button Grid.Row="2" Content="{Binding CloseLabel}" Command="{Binding CloseCommand}"
                    HorizontalAlignment="Stretch" Padding="28,24" FontSize="26" Margin="0,24,0,0"/>

        </Grid>
    </Border>

</UserControl>
