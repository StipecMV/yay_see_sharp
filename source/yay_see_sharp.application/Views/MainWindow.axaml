<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:yay_see_sharp.application.ViewModels"
        xmlns:icons="using:yay_see_sharp.application.Views.Icons"
        xmlns:conv="using:yay_see_sharp.application.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="yay_see_sharp.application.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Default}"
        Title="Yay See Sharp">

    <Design.DataContext>
        <vm:DesignMainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <Grid ColumnDefinitions="280,*">

            <!-- Sidebar -->
            <Grid Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                  RowDefinitions="Auto,*,Auto" Margin="20,32">

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="4,0,0,24">
                    <icons:LogoMark Size="48"/>
                    <TextBlock Text="Yay See Sharp" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <ListBox Grid.Row="1" Theme="{StaticResource NavListBox}"
                         VerticalAlignment="Top"
                         ItemsSource="{Binding MainNavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=OneWay}"
                         SelectionChanged="OnMainSidebarSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <icons:GridIcon Width="28" Height="28" Stroke="{Binding $parent[ListBoxItem].Foreground}"
                                                IsVisible="{Binding Section, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Dashboard}"/>
                                <icons:SearchIcon Width="28" Height="28" Stroke="{Binding $parent[ListBoxItem].Foreground}"
                                                   IsVisible="{Binding Section, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Search}"/>
                                <icons:BoxIcon Width="28" Height="28" Stroke="{Binding $parent[ListBoxItem].Foreground}"
                                                IsVisible="{Binding Section, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Installed}"/>
                                <TextBlock Text="{Binding Title}" Foreground="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- UI-14: Settings pinned to the bottom of the sidebar, in its own group — a plain
                     button (not a second ListBox two-way-bound to SelectedNavigationItem; see
                     MainWindowViewModel's IsSettingsSelected doc comment for why). -->
                <Button Grid.Row="2" Classes="navItem" Classes.selected="{Binding IsSettingsSelected}"
                        VerticalAlignment="Bottom" Command="{Binding SelectSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <icons:GearIcon Width="28" Height="28" Stroke="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Text="{Binding SettingsNavigationItem.Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>

            <!-- Content -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border Grid.Row="0" IsVisible="{Binding HasWarning}"
                        Background="{DynamicResource Brush.AccentTint}"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                        Padding="40,16">
                    <TextBlock Text="{Binding WarningMessage}" FontSize="23"
                               Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
            </Grid>

        </Grid>

        <!-- Global auth prompt overlay: blocks interaction with the rest of the window. -->
        <Border IsVisible="{Binding AuthPrompt, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource Brush.ScrimBackdrop}">
            <ContentControl Content="{Binding AuthPrompt}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Shown once at startup on Arch/CachyOS when yay wasn't found on PATH. -->
        <Border IsVisible="{Binding BackendInstallPrompt, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource Brush.ScrimBackdrop}">
            <ContentControl Content="{Binding BackendInstallPrompt}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- UI-22: in-app toast stack, bottom-right, auto-dismissing (UI-06) — see ToastService. -->
        <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="40">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="16" HorizontalAlignment="Right"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastViewModel">
                    <Border Width="640" Background="{DynamicResource Brush.Surface}" CornerRadius="16"
                            BorderBrush="{Binding Level, Converter={x:Static conv:NotificationLevelBrushConverter.Instance}}"
                            BorderThickness="2" Padding="28,24" BoxShadow="{DynamicResource Shadow.Lg}">
                        <Grid ColumnDefinitions="8,*,Auto">
                            <Border Grid.Column="0" CornerRadius="4" Margin="0,0,20,0"
                                    Background="{Binding Level, Converter={x:Static conv:NotificationLevelBrushConverter.Instance}}"/>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Body}" FontSize="24" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Content="×" Command="{Binding DismissCommand}" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Panel>

</Window>
